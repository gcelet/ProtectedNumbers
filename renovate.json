{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:base"
    ],
    "baseBranches": ["develop"],
    "commitMessagePrefix": ":arrow_up: chore:",
    "commitMessageAction": "upgrade",
    "major": {
        "automerge": false
    },
    "packageRules": [
        {
            "updateTypes": [
                "pin"
            ],
            "commitMessagePrefix": ":pushpin: chore:",
            "commitMessageAction": "pin"
        },
        {
            "updateTypes": [
                "rollback"
            ],
            "commitMessagePrefix": ":arrow_down: chore:",
            "commitMessageAction": "downgrade"
        },
        {
          "matchManagers": ["nuget"],
          "matchDatasources": ["nuget"],
          "matchFileNames": ["Directory.Packages.net6.props"],
          "matchPackageNames": ["FastEndpoints"],
          "matchCurrentVersion": "<6.0.0",
          "enabled": false
        },
        {
          "matchManagers": ["nuget"],
          "matchDatasources": ["nuget"],
          "matchFileNames": ["Directory.Packages.net6.props"],
          "matchPackageNames": ["Microsoft.NET.Test.Sdk"],
          "matchCurrentVersion": "<17.14.0",
          "enabled": false
        },
        {
          "matchManagers": ["nuget"],
          "matchDatasources": ["nuget"],
          "matchFileNames": ["Directory.Packages.net6.props"],
          "matchPackageNames": ["NUnit3TestAdapter"],
          "matchCurrentVersion": "<6.0.0",
          "enabled": false
        }
    ]
}
